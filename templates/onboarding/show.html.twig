{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}
<div class="container mx-auto py-8">
    <div class="mb-6">
        <a href="{{ path('app_onboarding_index') }}" class="text-blue-500 hover:text-blue-700">← Retour</a>
        <h1 class="text-3xl font-bold mt-2">{{ page_title }}</h1>
    </div>

    <div class="grid grid-cols-2 gap-6">
        <!-- Session Info -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-2xl font-bold mb-4 border-b pb-2">Informations de session</h2>
            <div class="space-y-3">
                <div>
                    <p class="text-sm text-gray-600">ID</p>
                    <p class="text-lg font-semibold">{{ session.id }}</p>
                </div>
                <div>
                    <p class="text-sm text-gray-600">Statut</p>
                    <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold {% if session.status == 'completed' %}bg-green-100 text-green-800{% elseif session.status == 'in_progress' %}bg-blue-100 text-blue-800{% else %}bg-gray-100 text-gray-800{% endif %}">
                        {% if session.status == 'in_progress' %}En cours{% elseif session.status == 'completed' %}Complété{% else %}{{ session.status }}{% endif %}
                    </span>
                </div>
                <div>
                    <p class="text-sm text-gray-600">Créée le</p>
                    <p class="text-lg">{{ session.createdAt|date('d/m/Y à H:i:s') }}</p>
                </div>
                <div>
                    <p class="text-sm text-gray-600">Dernière mise à jour</p>
                    <p class="text-lg">{{ session.updatedAt|date('d/m/Y à H:i:s') }}</p>
                </div>
                <div>
                    <p class="text-sm text-gray-600">Messages</p>
                    <p class="text-lg font-semibold">{{ displayMessages|length }}</p>
                </div>
            </div>
        </div>

        <!-- Extracted Data Summary -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-2xl font-bold mb-4 border-b pb-2">Données Extraites</h2>
            <div class="space-y-3">
                {% set data = session.extractedData %}
                {% if data|length > 0 %}
                    {% for key, value in data %}
                        <div>
                            <p class="text-sm text-gray-600 capitalize">{{ key|replace('_', ' ') }}</p>
                            <p class="text-lg text-gray-800">
                                {% if value is iterable %}
                                    {{ value|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}
                                {% else %}
                                    {{ value }}
                                {% endif %}
                            </p>
                        </div>
                    {% endfor %}
                {% else %}
                    <p class="text-gray-500">Aucune donnée extraite</p>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Messages History -->
    <div class="bg-white rounded-lg shadow-md p-6 mt-6">
        <h2 class="text-2xl font-bold mb-4 border-b pb-2">Historique complet</h2>
        
        <div class="space-y-4 max-h-96 overflow-y-auto">
            {% if displayMessages|length > 0 %}
                {% for message in displayMessages %}
                    <div class="{% if message.role == 'user' %}bg-blue-50 border-l-4 border-blue-500{% else %}bg-gray-50 border-l-4 border-gray-300{% endif %} p-4 rounded">
                        <p class="font-semibold text-sm text-gray-600 mb-1">
                            {% if message.role == 'user' %}Utilisateur{% else %}Assistant{% endif %}
                            <span class="text-xs text-gray-500">{{ message.timestamp or 'N/A' }}</span>
                        </p>
                        <p class="text-gray-800">{{ message.content }}</p>
                    </div>
                {% endfor %}
            {% else %}
                <p class="text-gray-500 text-center py-8">Aucun message</p>
            {% endif %}
        </div>
    </div>

    <!-- Field Edit Audit Trail -->
    <div class="bg-white rounded-lg shadow-md p-6 mt-6">
        <h2 class="text-2xl font-bold mb-2 border-b pb-2">Audit des modifications de champs</h2>

        {% if sourcing_report is defined %}
        <div class="flex gap-4 mb-4 text-sm">
            <span class="px-2 py-1 bg-blue-100 text-blue-800 rounded">Déclaré : {{ sourcing_report.declared }}</span>
            <span class="px-2 py-1 bg-purple-100 text-purple-800 rounded">Détecté IA : {{ sourcing_report.detected }}</span>
            <span class="px-2 py-1 bg-yellow-100 text-yellow-800 rounded">Mis à jour : {{ sourcing_report.updated }}</span>
            <span class="px-2 py-1 bg-green-100 text-green-800 rounded">Corrigé : {{ sourcing_report.corrected }}</span>
        </div>
        {% endif %}

        {% if field_edits is defined and field_edits|length > 0 %}
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="bg-gray-50 text-gray-600 uppercase text-xs">
                    <tr>
                        <th class="px-3 py-2">Horodatage</th>
                        <th class="px-3 py-2">Champ</th>
                        <th class="px-3 py-2">Source</th>
                        <th class="px-3 py-2">Rôle</th>
                        <th class="px-3 py-2">Auteur</th>
                        <th class="px-3 py-2">Ancienne valeur</th>
                        <th class="px-3 py-2">Nouvelle valeur</th>
                        <th class="px-3 py-2">Raison</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for edit in field_edits %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-3 py-2 text-gray-500 whitespace-nowrap">{{ edit.timestamp|date('d/m/Y H:i:s') }}</td>
                        <td class="px-3 py-2 font-mono text-xs text-gray-800">{{ edit.fieldPath }}</td>
                        <td class="px-3 py-2">
                            {% if edit.source == 'declared' %}
                                <span class="px-2 py-0.5 bg-blue-100 text-blue-700 rounded text-xs">déclaré</span>
                            {% elseif edit.source == 'detected' %}
                                <span class="px-2 py-0.5 bg-purple-100 text-purple-700 rounded text-xs">IA</span>
                            {% elseif edit.source == 'updated' %}
                                <span class="px-2 py-0.5 bg-yellow-100 text-yellow-700 rounded text-xs">mis à jour</span>
                            {% elseif edit.source == 'corrected' %}
                                <span class="px-2 py-0.5 bg-green-100 text-green-700 rounded text-xs">corrigé</span>
                            {% else %}
                                <span class="text-gray-400 text-xs">{{ edit.source }}</span>
                            {% endif %}
                        </td>
                        <td class="px-3 py-2 text-xs text-gray-600">{{ edit.role }}</td>
                        <td class="px-3 py-2 text-xs text-gray-600">{{ edit.author ?? '—' }}</td>
                        <td class="px-3 py-2 text-xs text-gray-400 max-w-xs truncate" title="{{ edit.oldValue|json_encode }}">
                            {% if edit.oldValue is not null %}{{ edit.oldValue|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}{% else %}—{% endif %}
                        </td>
                        <td class="px-3 py-2 text-xs text-gray-800 max-w-xs truncate" title="{{ edit.newValue|json_encode }}">
                            {{ edit.newValue|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}
                        </td>
                        <td class="px-3 py-2 text-xs text-gray-500">{{ edit.reason ?? '' }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        <p class="text-gray-500 text-center py-6">Aucune modification de champ tracée.</p>
        {% endif %}
    </div>

    <!-- Action Buttons -->
    <div class="flex gap-4 mt-6">
        {% if session.status == 'in_progress' %}
            <a href="{{ path('app_onboarding_chat', {id: session.id}) }}" class="px-6 py-3 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition">
                Continuer le chat
            </a>
            <a href="{{ path('app_onboarding_review', {id: session.id}) }}" class="px-6 py-3 bg-green-500 text-white rounded-lg hover:bg-green-600 transition">
                Valider le profil
            </a>
        {% elseif session.status == 'completed' %}
            {% if session.account %}
                <a href="{{ path('app_account_show', {id: session.account.id}) }}" class="px-6 py-3 bg-purple-500 text-white rounded-lg hover:bg-purple-600 transition">
                    Voir le compte créé
                </a>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endblock %}
