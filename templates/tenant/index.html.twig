{% extends 'base.html.twig' %}

{% block title %}Tenants{% endblock %}

{% block body %}
    <div class="section-head">
        <div>
            <p class="muted">Pilotage beta</p>
            <h1>Tenants</h1>
        </div>
        <div class="actions">
            <a class="button-link secondary" href="{{ path('app_pilotage_index') }}">Pilotage</a>
            <a class="button-link" href="{{ path('app_tenant_new') }}">Nouveau tenant</a>
        </div>
    </div>

    <section class="section-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Tenant</th>
                    <th>Code</th>
                    <th>Plan</th>
                    <th>Statut</th>
                    <th>Utilisateurs</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for tenant in tenants %}
                    <tr>
                        <td>{{ tenant.name }}</td>
                        <td>{{ tenant.code }}</td>
                        <td>{{ tenant.planLabel }}</td>
                        <td><span class="status-pill {{ tenant.active ? 'status-won' : 'status-lost' }}">{{ tenant.statusLabel }}</span></td>
                        <td>{{ tenant.users|length }}</td>
                        <td><a href="{{ path('app_tenant_show', {id: tenant.id}) }}">Ouvrir</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="muted">Aucun tenant beta.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
{% endblock %}
