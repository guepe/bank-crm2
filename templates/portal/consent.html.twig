{% extends 'base.html.twig' %}

{% block title %}Consentement{% endblock %}

{% block body %}
    <div class="topline">
        <p class="muted">Planilife</p>
        <h1>Consentement</h1>
        <p class="muted">Avant l'entretien, vous gardez la main sur les usages de vos donnees.</p>
    </div>

    <section class="section-card">
        <h2>Ce que vous validez</h2>
        <ul class="plain-list">
            <li>Vos reponses alimentent votre dossier Planilife et peuvent etre structurees par l'assistant IA.</li>
            <li>Les donnees utiles peuvent servir a generer une synthese ou un rapport a votre demande.</li>
            <li>Tout partage avec un prescripteur doit faire l'objet d'une validation explicite de votre part.</li>
            <li>Vous pouvez consulter, exporter ou demander la suppression de vos donnees depuis le portail.</li>
        </ul>

        <form method="post" class="stack">
            <input type="hidden" name="_token" value="{{ csrf_token('portal-consent-' ~ portal_user.id) }}">
            <label>
                <input type="checkbox" name="accept_consent" value="1" required>
                J'ai compris et j'accepte le traitement de mes donnees pour mon dossier Planilife.
            </label>
            <div class="actions">
                <button type="submit">Valider et commencer l'entretien</button>
                <a class="button-link secondary" href="{{ path('app_portal_dashboard') }}">Retour au portail</a>
            </div>
        </form>
    </section>
{% endblock %}
