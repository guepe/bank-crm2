{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}
    <div class="topline">
        <p class="muted">Compte client</p>
        <h1>{{ page_title }}</h1>
        <p class="muted">Recevez un lien temporaire pour definir un nouveau mot de passe.</p>
    </div>

    <section class="section-card">
        {{ form_start(form, {attr: {class: 'stack'}}) }}
            {{ form_row(form.identifier) }}
            <div class="actions">
                <button type="submit">Envoyer le lien</button>
                <a class="button-link secondary" href="{{ path('app_login') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
